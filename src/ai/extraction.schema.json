{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskflow.local/schemas/ai-extraction.schema.json",
  "title": "TaskFlow AI extraction result",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "evidence", "needs_review"],
        "properties": {
          "type": { "type": "string", "enum": ["task", "event", "note"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "priority": { "type": "string", "enum": ["high", "normal", "low"] },
          "start_at": { "type": ["string", "null"], "format": "date-time" },
          "due_at": { "type": ["string", "null"], "format": "date-time" },
          "location": { "type": ["string", "null"] },
          "assignee": { "type": ["string", "null"] },
          "evidence": { "type": "string", "minLength": 1 },
          "time_precision": { "type": "string", "enum": ["minute", "day", "unknown"] },
          "date_expression": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "needs_review": { "type": "boolean" }
        }
      }
    }
  }
}
